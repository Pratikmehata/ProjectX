# ── AI Provider (choose one) ──────────────────────────────────────────────────
# Get your Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=gemini api key

# Get your OpenAI key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Which provider to use: "gemini" or "openai"
AI_PROVIDER=gemini

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# In development, * allows all. In production, set your frontend URL:
# ALLOWED_ORIGINS=https://yourfrontend.com,http://localhost:3000
ALLOWED_ORIGINS=*
